  "narrative": {
    "northStar": "炭黑桌面工作台",
    "overview": "T-Cube 网站以用户指定的 [MotionObj Regex](https://motionobj.com/regex/) 为视觉参照：连续炭黑底色、开阔分栏、厚实简洁的标题、细描边行动入口与真实产品图像。它呈现一款随手可用的桌面工具；视觉证据来自现有应用图标、原生立方体渲染和 macOS / Windows 界面截图。\n\n整体安静、直接、克制。页面依靠字号、留白与分隔线建立层级，薄荷绿集中用于选择状态、链接和焦点。用户本次确定的新方向替代此前蓝灰底色以及早期 Apple / OpenAI 参考；无交替明暗章节、装饰画布或粒子背景。当前首屏与故事顺序属于[页面方向契约](.impeccable/surfaces/website-index-html.md)，不把单页布局当作所有未来页面的固定模板。",
    "keyCharacteristics": [
      "连续炭黑背景，以同色系表面和细线组织内容。",
      "Avenir Next Condensed / Roboto Condensed 标题配合 Avenir Next / Nunito Sans 正文；中文采用自然无衬线字形。",
      "近直角描边按钮，真实截图承担产品说明。",
      "中文默认、英文可切换，键盘操作与减少动态效果优先。"
    ],
    "rules": [
      {
        "name": "The Continuous Ground Rule",
        "body": "从页头到页脚延续 `bg`，章节通过留白与 `line` 分隔，产品承托面使用 `surface`。",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "页面表面保持平整，让原生立方体与截图提供产品深度。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 延续炭黑背景、同色承托面和细分隔线，以排版与留白组织信息。",
      "**Do** 使用真实应用图标、原生渲染与平台截图，保留图片比例和有效说明。",
      "**Do** 保持近直角描边 CTA、可见键盘焦点与明确的双平台下载入口。",
      "**Do** 同步中文和英文文案、图片替代文字与状态信息，并尊重减少动态效果设置。"
    ],
    "donts": [
      "**Don't** 重新引入旧蓝灰视觉、交替明暗章节或装饰粒子画布。",
      "**Don't** 给平整承托面新增投影、模糊玻璃层或胶囊式主要按钮。",
      "**Don't** 用虚构界面、用户数字或营销徽章替代真实产品证据。",
      "**Don't** 让连续动画在页面隐藏时运行，或要求 JavaScript 才能看到正文和下载链接。"
    ]
  }
}
